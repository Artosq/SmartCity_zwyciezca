# Skopiuj ten plik do .env.local i uzupełnij wartościami z Supabase.
# .env.local NIE trafia do repozytorium (jest w .gitignore).

# Supabase → Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co

# Supabase → Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
